// Super-xBR second step, at twice the game picture's size. Each 2x2 block takes the game pixel at top left and the
// first step's result at bottom right; the other two pixels get new colours from the 4x4 neighbourhood, rotated 45
// degrees, that these two grids form around them. Alpha holds the luma.
// binding 0: superxbr_p0's output, NEAREST (texelFetch). binding 1: the game picture, NEAREST (texelFetch); its luma is
// computed here.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform P {
    vec4 SourceSize;
    vec4 OriginalSize;
    vec4 OutputSize;
    vec4 unused_;
} k;

const vec3 Y = vec3(.2126, .7152, .0722);

float RGBtoYUV(vec3 color) { return dot(color, Y); }

float df(float A, float B) { return abs(A - B); }

/*
                              P1
     |P0|B |C |P1|         C     F4          |a0|b1|c2|d3|
     |D |E |F |F4|      B     F     I4       |b0|c1|d2|e3|   |e1|i1|i2|e2|
     |G |H |I |I4|   P0    E  A  I     P3    |c0|d1|e2|f3|   |e3|i3|i4|e4|
     |P2|H5|I5|P3|      D     H     I5       |d0|e1|f2|g3|
                           G     H5
                              P2
*/

float d_wd(float wp1, float wp2, float wp3, float wp4, float wp5, float wp6, float b0, float b1, float c0, float c1, float c2, float d0, float d1, float d2, float d3, float e1, float e2, float e3, float f2, float f3)
{
    return (wp1*(df(c1,c2) + df(c1,c0) + df(e2,e1) + df(e2,e3)) + wp2*(df(d2,d3) + df(d0,d1)) + wp3*(df(d1,d3) + df(d0,d2)) + wp4*df(d1,d2) + wp5*(df(c0,c2) + df(e1,e3)) + wp6*(df(b0,b1) + df(f2,f3)));
}

float hv_wd(float wp1, float wp2, float wp3, float wp4, float wp5, float wp6, float i1, float i2, float i3, float i4, float e1, float e2, float e3, float e4)
{
    return ( wp4*(df(i1,i2)+df(i3,i4)) + wp1*(df(i1,e1)+df(i2,e2)+df(i3,e3)+df(i4,e4)) + wp3*(df(i1,e2)+df(i3,e4)+df(e1,i2)+df(e3,i4)));
}

vec3 min4(vec3 a, vec3 b, vec3 c, vec3 d) { return min(a, min(b, min(c, d))); }
vec3 max4(vec3 a, vec3 b, vec3 c, vec3 d) { return max(a, max(b, max(c, d))); }

layout(set = 0, binding = 0) uniform sampler2D Source;
layout(set = 0, binding = 1) uniform sampler2D XbrSource;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dst;

const float XBR_EDGE_STR = 3.0;
const float XBR_WEIGHT = 1.0;

// Position in Source texels; the taps are point samples at it plus an offset, clamped to the edge.
vec2 g_pos;

vec4 tapS(vec2 off)
{
    ivec2 t = clamp(ivec2(floor(g_pos + off)), ivec2(0), ivec2(k.SourceSize.xy) - 1);
    return texelFetch(Source, t, 0);
}

vec4 tapX(vec2 off)
{
    ivec2 t = clamp(ivec2(floor(g_pos + off)), ivec2(0), textureSize(XbrSource, 0) - 1);
    vec3 c = texelFetch(XbrSource, t, 0).rgb;
    return vec4(c, RGBtoYUV(c));
}

void main()
{
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(gid), k.OutputSize.xy))) return;
    vec2 vTexCoord = (vec2(gid) + 0.5) * k.OutputSize.zw;
    g_pos = vTexCoord * k.SourceSize.xy;

    const float wp1 = 1.0, wp2 = 0.0, wp3 = 0.0, wp4 = 0.0, wp5 = 0.0, wp6 = 0.0;
    const float weight1 = XBR_WEIGHT*1.29633/10.0;
    const float weight2 = XBR_WEIGHT*1.75068/10.0/2.0;

    // Pixels on the two existing grids are copied.
    vec2 fp = fract(g_pos);
    vec2 dir = fp - vec2(0.5, 0.5);
    if ((dir.x*dir.y) > 0.0)
    {
        imageStore(dst, gid, dir.x >= 0.0 ? tapS(vec2(0.0)) : tapX(vec2(0.0)));
        return;
    }

    // Offsets of half a Source texel.
    vec2 g1 = (fp.x > 0.5) ? vec2(0.5, 0.0) : vec2(0.0, 0.5);
    vec2 g2 = (fp.x > 0.5) ? vec2(0.0, 0.5) : vec2(0.5, 0.0);

    vec4 P0_ = tapX(    -3.0*g1        ); vec3 P0 = P0_.rgb; float p0 = P0_.a;
    vec4 P1_ = tapS(            -3.0*g2); vec3 P1 = P1_.rgb; float p1 = P1_.a;
    vec4 P2_ = tapS(            +3.0*g2); vec3 P2 = P2_.rgb; float p2 = P2_.a;
    vec4 P3_ = tapX(    +3.0*g1        ); vec3 P3 = P3_.rgb; float p3 = P3_.a;

    vec4  B_ = tapS(    -2.0*g1     -g2); vec3  B =  B_.rgb; float  b =  B_.a;
    vec4  C_ = tapX(        -g1 -2.0*g2); vec3  C =  C_.rgb; float  c =  C_.a;
    vec4  D_ = tapS(    -2.0*g1     +g2); vec3  D =  D_.rgb; float  d =  D_.a;
    vec4  E_ = tapX(        -g1        ); vec3  E =  E_.rgb; float  e =  E_.a;
    vec4  F_ = tapS(                -g2); vec3  F =  F_.rgb; float  f =  F_.a;
    vec4  G_ = tapX(        -g1 +2.0*g2); vec3  G =  G_.rgb; float  g =  G_.a;
    vec4  H_ = tapS(                +g2); vec3  H =  H_.rgb; float  h =  H_.a;
    vec4  I_ = tapX(        +g1        ); vec3  I =  I_.rgb; float  i =  I_.a;

    vec4 F4_ = tapX(        +g1 -2.0*g2); vec3 F4 = F4_.rgb; float f4 = F4_.a;
    vec4 I4_ = tapS(    +2.0*g1     -g2); vec3 I4 = I4_.rgb; float i4 = I4_.a;
    vec4 H5_ = tapX(        +g1 +2.0*g2); vec3 H5 = H5_.rgb; float h5 = H5_.a;
    vec4 I5_ = tapS(    +2.0*g1     +g2); vec3 I5 = I5_.rgb; float i5 = I5_.a;

    // Edgeness in the diagonal directions.
    float d_edge  = (d_wd( wp1, wp2, wp3, wp4, wp5, wp6, d, b, g, e, c, p2, h, f, p1, h5, i, f4, i5, i4 ) - d_wd( wp1, wp2, wp3, wp4, wp5, wp6, c, f4, b, f, i4, p0, e, i, p3, d, h, i5, g, h5 ));

    // Edgeness in the horizontal and vertical directions.
    float hv_edge = (hv_wd(wp1, wp2, wp3, wp4, wp5, wp6, f, i, e, h, c, i5, b, h5) - hv_wd(wp1, wp2, wp3, wp4, wp5, wp6, e, f, h, i, d, f4, g, i4));

    float limits = XBR_EDGE_STR + 0.000001;
    float edge_strength = smoothstep(0.0, limits, abs(d_edge));

    // Filter weights, two taps only.
    vec4 w1 = vec4(-weight1, weight1 + 0.5, weight1 + 0.5, -weight1);
    vec4 w2 = vec4(-weight2, weight2 + 0.25, weight2 + 0.25, -weight2);
    vec3 c3 = mat4x3(D+G, E+H, F+I, F4+I4) * w2;
    vec3 c4 = mat4x3(C+B, F+E, I+H, I5+H5) * w2;

    // Filtering in four directions, giving four colours.
    vec3 c1 = mat4x3(P2, H, F, P1) * w1;
    vec3 c2 = mat4x3(P0, E, I, P3) * w1;

    // Blend of the two strongest directions: one diagonal, one horizontal or vertical.
    vec3 color = mix(mix(c1, c2, step(0.0, d_edge)), mix(c3, c4, step(0.0, hv_edge)), 1.0 - edge_strength);

    // Anti-ringing.
    vec3 min_sample = min4(E, F, H, I);
    vec3 max_sample = max4(E, F, H, I);
    color = clamp(color, min_sample, max_sample);

    imageStore(dst, gid, vec4(color, RGBtoYUV(color)));
}
