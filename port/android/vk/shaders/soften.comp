// The game's docked upscale replaced by one Mitchell-Netravali cubic (nvn_vulkan_soften.inc): (B, C) sets the look from
// Catmull-Rom (0, 1/2: no blur, no sharpening) through Mitchell (1/3, 1/3) to the B-spline (1, 0: softest). Shrinking
// (a supersampled scene) widens the kernel by the ratio, so every source texel counts. Values above 1 are kept.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform P {
    // xy: the scene's valid region in the source texture (dynamic resolution draws a smaller one), zw: the output size
    vec4 size;
    // x: B, y: C, z: the kernel's width over the source texel's (1 when enlarging)
    vec4 kern;
} k;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;
float mitchell(float x) {
    float B = k.kern.x, C = k.kern.y; x = abs(x);
    if (x < 1.0) return ((12.0 - 9.0 * B - 6.0 * C) * x * x * x + (-18.0 + 12.0 * B + 6.0 * C) * x * x + (6.0 - 2.0 * B)) / 6.0;
    if (x < 2.0) return ((-B - 6.0 * C) * x * x * x + (6.0 * B + 30.0 * C) * x * x + (-12.0 * B - 48.0 * C) * x + (8.0 * B + 24.0 * C)) / 6.0;
    return 0.0;
}
void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= int(k.size.z) || o.y >= int(k.size.w)) return;
    float s = clamp(k.kern.z, 1.0, 2.0);
    vec2 p = (vec2(o) + 0.5) * k.size.xy / k.size.zw - 0.5;
    ivec2 lo = ivec2(floor(p - 2.0 * s)) + 1, hi = ivec2(k.size.xy) - 1;
    // at most 8 taps an axis (s <= 2)
    float wx[8], wy[8];
    int n = int(floor(4.0 * s)); if (n > 8) n = 8;
    for (int i = 0; i < n; i++) { wx[i] = mitchell((float(lo.x + i) - p.x) / s); wy[i] = mitchell((float(lo.y + i) - p.y) / s); }
    vec4 c = vec4(0.0); float ws = 0.0;
    for (int y = 0; y < n; y++) for (int x = 0; x < n; x++) {
        float w = wx[x] * wy[y];
        c += w * texelFetch(src, clamp(lo + ivec2(x, y), ivec2(0), hi), 0); ws += w;
    }
    c /= ws;
    // the negative lobes (C > 0) ring at hard edges: keep within the nearest 2x2 source texels
    ivec2 b = clamp(ivec2(floor(p)), ivec2(0), hi);
    vec4 a0 = texelFetch(src, b, 0), a1 = texelFetch(src, min(b + ivec2(1, 0), hi), 0), a2 = texelFetch(src, min(b + ivec2(0, 1), hi), 0), a3 = texelFetch(src, min(b + 1, hi), 0);
    c = clamp(c, min(min(a0, a1), min(a2, a3)), max(max(a0, a1), max(a2, a3)));
    imageStore(dst, o, max(c, vec4(0.0)));
}
