// ScaleFX (Sp00kyFox), pass 4 of 5: subpixel output, filtered to the output size.
// Each game picture pixel becomes 3x3 subpixels; each one takes the colour
// of the neighbour named by its pass 3 tag (0 = E, 1 = D, 2 = D0, 3 = F,
// 4 = F0, 5 = B, 6 = B0, 7 = H, 8 = H0), so the subpixels hold only colours
// of the game picture. An output pixel is the area-weighted mean of the
// subpixels it covers: at 3x the picture's size that is one subpixel (the
// original ScaleFX output); at the screen's size it stands in for a 3x
// picture shrunk to the screen, without writing the 3x picture.
// Source is the pass 3 tags; binding 1 is the game picture.

#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform P { vec4 SourceSize; vec4 OriginalSize; vec4 OutputSize; vec4 unused_; } k;

layout(set = 0, binding = 0) uniform sampler2D Source;
layout(set = 0, binding = 1) uniform sampler2D refpass;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dst;

// corner tags
vec4 loadCrn(vec4 x) { return floor(mod(x * 80.0 + 0.5, 9.0)); }

// mid tags
vec4 loadMid(vec4 x) { return floor(mod(x * 8.888888 + 0.055555, 9.0)); }

vec3 subpixel(ivec2 sub) {
    /*  grid        corners     mids

          B         x   y         x
        D E F                   w   y
          H         w   z         z
    */
    ivec2 pos = sub / 3;
    ivec2 fp = sub - pos * 3;

    vec4 E = texelFetch(Source, pos, 0);
    vec4 crn = loadCrn(E);
    vec4 mid = loadMid(E);

    float sp = fp.y == 0 ? (fp.x == 0 ? crn.x : fp.x == 1 ? mid.x : crn.y)
             : fp.y == 1 ? (fp.x == 0 ? mid.w : fp.x == 1 ? 0.0   : mid.y)
             :             (fp.x == 0 ? crn.w : fp.x == 1 ? mid.z : crn.z);

    ivec2 res = sp == 0.0 ? ivec2( 0,  0) : sp == 1.0 ? ivec2(-1,  0) : sp == 2.0 ? ivec2(-2,  0)
              : sp == 3.0 ? ivec2( 1,  0) : sp == 4.0 ? ivec2( 2,  0) : sp == 5.0 ? ivec2( 0, -1)
              : sp == 6.0 ? ivec2( 0, -2) : sp == 7.0 ? ivec2( 0,  1) : ivec2( 0,  2);

    ivec2 refMax = textureSize(refpass, 0) - 1;
    return texelFetch(refpass, clamp(pos + res, ivec2(0), refMax), 0).rgb;
}

void main() {
    ivec2 opos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(opos, ivec2(k.OutputSize.xy)))) return;

    // the output pixel's footprint in subpixels: at most 3 wide while the output is at least the picture's size, so
    // it touches at most 4 subpixels a side
    vec2 f = 3.0 * k.SourceSize.xy / k.OutputSize.xy;
    vec2 a = vec2(opos) * f, b = a + f;
    ivec2 lo = ivec2(floor(a)), hi = min(ivec2(ceil(b - 1e-4)), ivec2(3.0 * k.SourceSize.xy)) - 1;
    hi = min(hi, lo + 3);
    vec3 sum = vec3(0.0);
    float total = 0.0;
    for (int y = lo.y; y <= hi.y; y++) {
        float wy = min(b.y, float(y + 1)) - max(a.y, float(y));
        for (int x = lo.x; x <= hi.x; x++) {
            float w = wy * (min(b.x, float(x + 1)) - max(a.x, float(x)));
            sum += w * subpixel(ivec2(x, y));
            total += w;
        }
    }
    imageStore(dst, opos, vec4(sum / total, 1.0));
}
