// Lanczos-3 upscaling: the windowed sinc with three lobes, 6x6 taps, weights normalised, one output pixel a thread. No
// anti-ringing: hard edges get thin light and dark outlines, as the classic filter does.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform P {
    // xy: the picture's size in the source texture, zw: the output size
    vec4 size;
} k;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
const float PI = 3.14159265358979;
float lanczos3(float x) {
    x = abs(x);
    if (x < 1e-5) return 1.0;
    if (x >= 3.0) return 0.0;
    float a = PI * x, b = a / 3.0;
    return sin(a) * sin(b) / (a * b);
}
void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= int(k.size.z) || o.y >= int(k.size.w)) return;
    vec2 p = (vec2(o) + 0.5) * k.size.xy / k.size.zw - 0.5, b = floor(p), f = p - b;
    ivec2 hi = ivec2(k.size.xy) - 1;
    float wx[6], wy[6];
    for (int i = 0; i < 6; i++) { wx[i] = lanczos3(float(i - 2) - f.x); wy[i] = lanczos3(float(i - 2) - f.y); }
    vec3 c = vec3(0.0); float ws = 0.0;
    for (int y = 0; y < 6; y++) for (int x = 0; x < 6; x++) {
        float w = wx[x] * wy[y];
        c += w * texelFetch(src, clamp(ivec2(b) + ivec2(x - 2, y - 2), ivec2(0), hi), 0).rgb; ws += w;
    }
    imageStore(dst, o, vec4(clamp(c / ws, 0.0, 1.0), 1.0));
}
