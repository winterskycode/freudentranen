// Frame generation's motion field at the picture's time t (framegen_interp.comp reads it): every depth texel of this frame
// (or, with the field at half the depth's size, the nearest of each 2x2) moves to where its surface is at t
// (pos + (1 - t) motion) and lands on the 2x2 field texels around that point; where several land on one texel, the nearest
// wins. Two passes over the field's texels (size.w): 0 keeps the nearest depth per texel (atomic minimum of the float
// bits, which order like the values for depths >= 0), 1 writes the winner's source depth texel. Texels nothing lands on
// keep all ones: what is there at t was hidden in this frame (disocclusion). With opt.z bit 2 (or bit 1, the quality
// test's classes), pass 0 also keeps, at half the depth's size, the nearest depth landing on each texel at the previous
// frame's time (splat_prev): what that frame showed in front.
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "framegen_common.glsl"

// The nearest of the 2x2 depth texels from b (its depth in d), clamped to the depth's size.
ivec2 nearest_of_2x2(ivec2 b, ivec2 ds, out float d) {
    // w: b, z: (b.x + 1, b.y), x: (b.x, b.y + 1), y: b + 1
    vec4 g = textureGather(depth, (vec2(b) + 1.0) / vec2(ds), 0);
    ivec2 n = b + 1;
    d = min(g.y, 1.0);
    if (g.x < d) { d = g.x; n = b + ivec2(0, 1); }
    if (g.z < d) { d = g.z; n = b + ivec2(1, 0); }
    if (g.w < d) { d = g.w; n = b; }
    return min(n, ds - 1);
}

void main() {
    // opt.z bit 8: the field at half the depth's size, each texel the nearest of a 2x2 of depth texels
    bool half_field = (int(p.opt.z) & 256) != 0;
    ivec2 q = ivec2(gl_GlobalInvocationID.xy), ds = textureSize(depth, 0), fs = imageSize(splat_depth);
    if (q.x >= fs.x || q.y >= fs.y) return;
    float d; ivec2 n = q;
    if (half_field) n = nearest_of_2x2(q * 2, ds, d);
    else d = min(texelFetch(depth, q, 0).r, 1.0);
    vec2 pu = (vec2(n) + 0.5) / vec2(ds);
    vec2 m = texel_motion(pu, d), at = (pu + (1.0 - p.scale.w) * m) * vec2(fs) - 0.5;
    ivec2 b = ivec2(floor(at));
    uint key = floatBitsToUint(d), src = uint(n.x) | (uint(n.y) << 16);
    for (int i = 0; i < 4; i++) {
        ivec2 c = b + ivec2(i & 1, i >> 1);
        if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, fs))) continue;
        if (p.size.w == 0.0) imageAtomicMin(splat_depth, c, key);
        else if (imageLoad(splat_depth, c).r == key) imageStore(splat_src, c, uvec4(src));
    }
    // splat_prev, at half the depth's size: one texel of each 2x2 (the nearest of them) lands on the texel nearest its spot
    if (p.size.w == 0.0 && (int(p.opt.z) & 6) != 0 && (half_field || ((q.x & 1) == 0 && (q.y & 1) == 0))) {
        float dn; ivec2 nn = n;
        if (half_field) dn = d; else nn = nearest_of_2x2(q, ds, dn);
        vec2 pn = (vec2(nn) + 0.5) / vec2(ds);
        ivec2 hs = imageSize(splat_prev), c = ivec2(floor((pn + texel_motion(pn, dn)) * vec2(hs)));
        if (all(greaterThanEqual(c, ivec2(0))) && all(lessThan(c, hs))) imageAtomicMin(splat_prev, c, floatBitsToUint(dn));
    }
}
