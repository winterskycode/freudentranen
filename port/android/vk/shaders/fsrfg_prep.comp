// FSR frame interpolation's inputs from ours (nvn_vulkan_fsrfg.inc): the scene encoded for display, a copy of the depth,
// and the camera's motion: reproj = VP_prev * inverse(VP_cur) (see framegen_interp.comp). FSR's motion vector is where the
// point was in the previous frame, minus where it is now, in picture units: ours.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform P {
    mat4 reproj;
    // w, h, 1/w, 1/h
    vec4 size;
    // x: clip-space y direction, y: motion passes' scale (1, 2: the nearest of each 2x2), z: optical flow's scale, w: 1
    // when the picture is a scene (linear, sRGB-encoded here)
    vec4 opt;
    // xy: the picture's share of the picture texture, zw: the scene's share of the depth target (dynamic resolution)
    vec4 scale;
} p;
layout(set = 0, binding = 0) uniform sampler2D pic;
layout(set = 0, binding = 1) uniform sampler2D depth;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D color;
layout(set = 0, binding = 3, rg16f) uniform writeonly image2D motion;
layout(set = 0, binding = 4, r32f) uniform writeonly image2D depth_out;
// for optical flow at half size
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D color_half;
vec3 enc(vec3 c) {
    if (p.opt.w == 0.0) return c;
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}
void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= int(p.size.x) || o.y >= int(p.size.y)) return;
    vec2 uv = (vec2(o) + 0.5) * p.size.zw;
    imageStore(color, o, vec4(enc(textureLod(pic, uv * p.scale.xy, 0.0).rgb), 1.0));
    // one bilinear sample: the mean of the 2x2
    if (p.opt.z > 1.5 && o.x % 2 == 0 && o.y % 2 == 0)
        imageStore(color_half, o / 2, vec4(enc(textureLod(pic, (vec2(o) + 1.0) * p.size.zw * p.scale.xy, 0.0).rgb), 1.0));
    int s = int(p.opt.y);
    if (o.x % s != 0 || o.y % s != 0) return;
    ivec2 ds = textureSize(depth, 0), near = o;
    float d = 2.0;
    for (int y = 0; y < s; y++) for (int x = 0; x < s; x++) {
        vec2 u = (vec2(o + ivec2(x, y)) + 0.5) * p.size.zw;
        float t = texelFetch(depth, clamp(ivec2(u * p.scale.zw * vec2(ds)), ivec2(0), ds - 1), 0).r;
        if (t < d) { d = t; near = o + ivec2(x, y); }
    }
    uv = (vec2(near) + 0.5) * p.size.zw;
    imageStore(depth_out, o / s, vec4(d));
    vec4 c = p.reproj * vec4(uv.x * 2.0 - 1.0, p.opt.x * (1.0 - uv.y * 2.0), d * 2.0 - 1.0, 1.0);
    vec2 m = vec2(0.0);
    if (c.w > 1e-7) { vec2 n = c.xy / c.w; m = vec2(n.x * 0.5 + 0.5, 0.5 - 0.5 * p.opt.x * n.y) - uv; }
    imageStore(motion, o / s, vec4(m, 0.0, 0.0));
}
