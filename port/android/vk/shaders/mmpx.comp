// MMPX style-preserving pixel art magnification (Morgan McGuire & Mara Gagiu, 2021; MIT, third_party/mmpx), after its
// GLSL version: each source pixel becomes 2x2 (J K / L M), its corners taken from a neighbour along 1:1 and 2:1 slopes
// and intersections where pixels of exactly the same colour line up, else its own colour (nearest). Rendered 3D
// pictures have few exactly equal neighbours, so most of them come out doubled. One source pixel a thread; the caller
// scales the 2x picture to the screen.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform P {
    // xy: the picture's size in the source texture
    ivec4 size;
} k;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;

// colours as packed 8-bit ABGR, alpha set: equality is exact, as the method needs
uint src_at(int x, int y) {
    vec4 c = texelFetch(src, clamp(ivec2(x, y), ivec2(0), k.size.xy - 1), 0);
    uvec3 u = uvec3(round(clamp(c.rgb, 0.0, 1.0) * 255.0));
    return 0xFF000000u | (u.b << 16) | (u.g << 8) | u.r;
}
vec4 decode(uint c) { return vec4(float(c & 0xFFu), float((c >> 8) & 0xFFu), float((c >> 16) & 0xFFu), 255.0) / 255.0; }
uint luma(uint C) {
    uint alpha = (C & 0xFF000000u) >> 24;
    return (((C & 0x00FF0000u) >> 16) + ((C & 0x0000FF00u) >> 8) + (C & 0x000000FFu) + 1u) * (256u - alpha);
}
bool all_eq2(uint B, uint A0, uint A1) { return ((B ^ A0) | (B ^ A1)) == 0u; }
bool all_eq3(uint B, uint A0, uint A1, uint A2) { return ((B ^ A0) | (B ^ A1) | (B ^ A2)) == 0u; }
bool all_eq4(uint B, uint A0, uint A1, uint A2, uint A3) { return ((B ^ A0) | (B ^ A1) | (B ^ A2) | (B ^ A3)) == 0u; }
bool any_eq3(uint B, uint A0, uint A1, uint A2) { return B == A0 || B == A1 || B == A2; }
bool none_eq2(uint B, uint A0, uint A1) { return (B != A0) && (B != A1); }
bool none_eq4(uint B, uint A0, uint A1, uint A2, uint A3) { return B != A0 && B != A1 && B != A2 && B != A3; }

void main() {
    int srcX = int(gl_GlobalInvocationID.x), srcY = int(gl_GlobalInvocationID.y);
    if (srcX >= k.size.x || srcY >= k.size.y) return;

    uint A = src_at(srcX - 1, srcY - 1), B = src_at(srcX, srcY - 1), C = src_at(srcX + 1, srcY - 1);
    uint D = src_at(srcX - 1, srcY + 0), E = src_at(srcX, srcY + 0), F = src_at(srcX + 1, srcY + 0);
    uint G = src_at(srcX - 1, srcY + 1), H = src_at(srcX, srcY + 1), I = src_at(srcX + 1, srcY + 1);

    uint J = E, K = E, L = E, M = E;

    if (((A ^ E) | (B ^ E) | (C ^ E) | (D ^ E) | (F ^ E) | (G ^ E) | (H ^ E) | (I ^ E)) != 0u) {
        uint P = src_at(srcX, srcY - 2), S = src_at(srcX, srcY + 2);
        uint Q = src_at(srcX - 2, srcY), R = src_at(srcX + 2, srcY);
        uint Bl = luma(B), Dl = luma(D), El = luma(E), Fl = luma(F), Hl = luma(H);

        // 1:1 slope rules
        if ((D == B && D != H && D != F) && (El >= Dl || E == A) && any_eq3(E, A, C, G) && ((El < Dl) || A != D || E != P || E != Q)) J = D;
        if ((B == F && B != D && B != H) && (El >= Bl || E == C) && any_eq3(E, A, C, I) && ((El < Bl) || C != B || E != P || E != R)) K = B;
        if ((H == D && H != F && H != B) && (El >= Hl || E == G) && any_eq3(E, A, G, I) && ((El < Hl) || G != H || E != S || E != Q)) L = H;
        if ((F == H && F != B && F != D) && (El >= Fl || E == I) && any_eq3(E, C, G, I) && ((El < Fl) || I != H || E != R || E != S)) M = F;

        // Intersection rules
        if ((E != F && all_eq4(E, C, I, D, Q) && all_eq2(F, B, H)) && (F != src_at(srcX + 3, srcY))) K = M = F;
        if ((E != D && all_eq4(E, A, G, F, R) && all_eq2(D, B, H)) && (D != src_at(srcX - 3, srcY))) J = L = D;
        if ((E != H && all_eq4(E, G, I, B, P) && all_eq2(H, D, F)) && (H != src_at(srcX, srcY + 3))) L = M = H;
        if ((E != B && all_eq4(E, A, C, H, S) && all_eq2(B, D, F)) && (B != src_at(srcX, srcY - 3))) J = K = B;
        if (Bl < El && all_eq4(E, G, H, I, S) && none_eq4(E, A, D, C, F)) J = K = B;
        if (Hl < El && all_eq4(E, A, B, C, P) && none_eq4(E, D, G, I, F)) L = M = H;
        if (Fl < El && all_eq4(E, A, D, G, Q) && none_eq4(E, B, C, I, H)) K = M = F;
        if (Dl < El && all_eq4(E, C, F, I, R) && none_eq4(E, B, A, G, H)) J = L = D;

        // 2:1 slope rules
        if (H != B) {
            if (H != A && H != E && H != C) {
                if (all_eq3(H, G, F, R) && none_eq2(H, D, src_at(srcX + 2, srcY - 1))) L = M;
                if (all_eq3(H, I, D, Q) && none_eq2(H, F, src_at(srcX - 2, srcY - 1))) M = L;
            }
            if (B != I && B != G && B != E) {
                if (all_eq3(B, A, F, R) && none_eq2(B, D, src_at(srcX + 2, srcY + 1))) J = K;
                if (all_eq3(B, C, D, Q) && none_eq2(B, F, src_at(srcX - 2, srcY + 1))) K = J;
            }
        }
        if (F != D) {
            if (D != I && D != E && D != C) {
                if (all_eq3(D, A, H, S) && none_eq2(D, B, src_at(srcX + 1, srcY + 2))) J = L;
                if (all_eq3(D, G, B, P) && none_eq2(D, H, src_at(srcX + 1, srcY - 2))) L = J;
            }
            if (F != E && F != A && F != G) {
                if (all_eq3(F, C, H, S) && none_eq2(F, B, src_at(srcX - 1, srcY + 2))) K = M;
                if (all_eq3(F, I, B, P) && none_eq2(F, H, src_at(srcX - 1, srcY - 2))) M = K;
            }
        }
    }

    imageStore(dst, ivec2(srcX * 2 + 0, srcY * 2 + 0), decode(J));
    imageStore(dst, ivec2(srcX * 2 + 1, srcY * 2 + 0), decode(K));
    imageStore(dst, ivec2(srcX * 2 + 0, srcY * 2 + 1), decode(L));
    imageStore(dst, ivec2(srcX * 2 + 1, srcY * 2 + 1), decode(M));
}
