// ScaleFX (Sp00kyFox), pass 1 of 5, 1x: corner candidate strength.
// From the pass 0 metrics, rates how strongly each of the four corners of a
// pixel is an interpolation candidate. Threshold 0.50 and filter AA on are
// the preset defaults.

#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform P { vec4 SourceSize; vec4 OriginalSize; vec4 OutputSize; vec4 unused_; } k;

layout(set = 0, binding = 0) uniform sampler2D Source;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D dst;

const float SFX_CLR = 0.50;
const float SFX_SAA = 1.00;

ivec2 pos;
ivec2 srcMax;

vec4 tex(int x, int y) { return texelFetch(Source, clamp(pos + ivec2(x, y), ivec2(0), srcMax), 0); }

// corner strength
float str(float d, vec2 a, vec2 b) {
    float diff = a.x - a.y;
    float wght1 = max(SFX_CLR - d, 0.0) / SFX_CLR;
    float wght2 = clamp((1.0 - d) + (min(a.x, b.x) + a.x > min(a.y, b.y) + a.y ? diff : -diff), 0.0, 1.0);
    return (SFX_SAA == 1.0 || 2.0 * d < a.x + a.y) ? (wght1 * wght2) * (a.x * a.y) : 0.0;
}

void main() {
    pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, ivec2(k.OutputSize.xy)))) return;
    srcMax = ivec2(k.SourceSize.xy) - 1;

    /*  grid        metric      pattern

        A B         x y z       x y
        D E F         o w       w z
        G H I
    */
    vec4 A = tex(-1, -1), B = tex( 0, -1);
    vec4 D = tex(-1,  0), E = tex( 0,  0), F = tex( 1,  0);
    vec4 G = tex(-1,  1), H = tex( 0,  1), I = tex( 1,  1);

    vec4 res;
    res.x = str(D.z, vec2(D.w, E.y), vec2(A.w, D.y));
    res.y = str(F.x, vec2(E.w, E.y), vec2(B.w, F.y));
    res.z = str(H.z, vec2(E.w, H.y), vec2(H.w, I.y));
    res.w = str(H.x, vec2(D.w, H.y), vec2(G.w, G.y));

    imageStore(dst, pos, res);
}
