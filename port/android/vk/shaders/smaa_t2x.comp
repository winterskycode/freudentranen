// SMAA T2x's temporal resolve (nvn_vulkan_smaa.inc; the reference's SMAAResolvePS with SMAA_REPROJECTION, third_party/smaa):
// this frame's SMAA result blended half and half with the last frame's (the other of the two jitter positions),
// reprojected with the camera's motion (from the depth and the last frame's view-projection: GL clip space, y up, depth
// not reversed), the last frame's weight lowered where the two frames' motion differs (the reference's velocity
// weighting, scale 30). The velocity is in texture coordinates; each frame keeps its own length for the next.
// The motion is the camera's only, so what moves by itself (Link) reprojects wrongly and would leave a one-frame trace
// (stretched into a trail by frame generation): the last frame is not used where the depth says the surface changed,
// either way: something nearer there last frame than anything in this pixel's 3x3 now (revealed), or this pixel nearer
// now than anything in the last frame's 3x3 there (covered); 5 % in view depth. The 3x3 on the compared side keeps a
// thin edge moved by the quarter-pixel jitter the same surface. misc.w = 1: not (measurement, live word t2xnodepth).
// misc.z = 1: the last frame's colour clamped to this frame's 3x3 (measurement, live word t2xclamp).
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform P {
    // previous view-projection * inverse(current view-projection)
    mat4 reproj;
    // w, h, 1/w, 1/h
    vec4 size;
    // reset, clip-space y direction, clamp, no depth test
    vec4 misc;
} p;
// this frame's SMAA result
layout(set = 0, binding = 0) uniform sampler2D cur;
// the last frame's
layout(set = 0, binding = 1) uniform sampler2D prev;
layout(set = 0, binding = 2) uniform sampler2D depth;
// the last frame's velocity length
layout(set = 0, binding = 3) uniform sampler2D vel_prev;
layout(set = 0, binding = 4, r11f_g11f_b10f) uniform writeonly image2D outp;
layout(set = 0, binding = 5, r16f) uniform writeonly image2D vel_next;
// the last frame's depth
layout(set = 0, binding = 6) uniform sampler2D depth_prev;
layout(set = 0, binding = 7, r32f) uniform writeonly image2D depth_next;
// view depth goes as 1 / (1 - d): a is nearer than b by more than 5 %
bool nearer(float a, float b) { return (1.0 - a) > 1.05 * (1.0 - b) + 1e-7; }
void main() {
    ivec2 P = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(P, ivec2(p.size.xy)))) return;
    vec2 uv = (vec2(P) + 0.5) * p.size.zw;
    float d = texelFetch(depth, P, 0).r;
    vec4 c = p.reproj * vec4(uv.x * 2.0 - 1.0, p.misc.y * (1.0 - uv.y * 2.0), d * 2.0 - 1.0, 1.0);
    // where this pixel was last frame, minus where it is
    vec2 mv = vec2(0.0);
    if (c.w > 1e-7) { vec2 n = c.xy / c.w; mv = vec2(n.x * 0.5 + 0.5, 0.5 - 0.5 * p.misc.y * n.y) - uv; }
    vec3 now = texelFetch(cur, P, 0).rgb;
    vec2 puv = uv + mv;
    vec3 before = textureLod(prev, puv, 0.0).rgb;
    float v = length(mv), vb = textureLod(vel_prev, puv, 0.0).r;
    float weight = 0.5 * clamp(1.0 - sqrt(abs(v - vb)) * 30.0, 0.0, 1.0);
    if (p.misc.x != 0.0 || any(lessThan(puv, vec2(0.0))) || any(greaterThan(puv, vec2(1.0)))) weight = 0.0;
    if (weight > 0.0 && p.misc.w == 0.0) {
        ivec2 last = ivec2(p.size.xy) - 1, Q = clamp(ivec2(puv * p.size.xy), ivec2(0), last);
        float was = texelFetch(depth_prev, Q, 0).r, near_now = d, near_was = was;
        for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
            near_now = min(near_now, texelFetch(depth, clamp(P + ivec2(x, y), ivec2(0), last), 0).r);
            near_was = min(near_was, texelFetch(depth_prev, clamp(Q + ivec2(x, y), ivec2(0), last), 0).r); }
        if (nearer(was, near_now) || nearer(d, near_was)) weight = 0.0;
    }
    if (p.misc.z == 1.0) {
        vec3 mn = now, mx = now;
        for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
            vec3 s = texelFetch(cur, clamp(P + ivec2(x, y), ivec2(0), ivec2(p.size.xy) - 1), 0).rgb; mn = min(mn, s); mx = max(mx, s); }
        before = clamp(before, mn, mx);
    }
    imageStore(outp, P, vec4(mix(now, before, weight), 1.0));
    imageStore(vel_next, P, vec4(v));
    imageStore(depth_next, P, vec4(d));
}
