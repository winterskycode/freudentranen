// Frame generation: the picture at a point in time between the previous and this game frame, or past this one
// (nvn_vulkan_framegen.inc), from the two scenes (no UI; the HUD goes on top afterwards, framegen_hud.comp) or the two
// finished pictures.
// Two motion candidates per pixel:
//  - the scene's: object motion where the motion pass drew (nvn_vulkan_motion.inc: last frame's normalised position of
//    what moved itself), else this frame's G-buffer depth reprojected with the previous frame's view-projection
//    (reproj = VP_prev * inverse(VP_cur), the Mac port's convention: GL clip space, depth not reversed);
//  - none: the HUD, and whatever moves with the camera (Link while it orbits him), stay where they are.
// A point at uv now was at uv + m in the previous frame; at time t (0 the previous frame, 1 this one, above 1 past it)
// it is at uv + (1 - t) m, so the output takes the current picture at o - (1 - t) m and the previous one at o + t m, and
// blends them by nearness in time (past this frame, the current picture alone: extrapolation). Each candidate is scored by how well a 3x3 patch of the current
// picture matches the previous one along it; the candidates and the current picture alone (for disocclusion and things
// moving on their own) are blended by those scores.
// With the splatted motion field (size.w, framegen_splat.comp) the scene's motion at a pixel is that of the surface that
// is there at t, not of what this frame shows there; where no surface of this frame lands (the background a nearer thing
// uncovers as it moves), the motion candidate is the previous picture along the far side's motion.
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#include "framegen_common.glsl"
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D dst;

// where uv was in the previous frame, minus uv (normalized picture units)
vec2 motion(vec2 uv) {
    ivec2 ds = textureSize(depth, 0), at = clamp(ivec2(uv * vec2(ds)), ivec2(0), ds - 1);
    float d = texelFetch(depth, at, 0).r;
    // Depth dilation: the motion of the nearest surface around. See-through things (lantern glass, flames, glow) write
    // no depth and would move with what is behind them, and the edges of thin things (poles) with the background.
    // Four texels a fetch (textureGather): the 2r x 2r texels from r before the pixel's texel to r - 1 after it.
    int r = int(p.opt.z) >> 2;
    ivec2 c0 = at;
    for (int y = 1 - r; y < r + 1; y += 2) for (int x = 1 - r; x < r + 1; x += 2) {
        ivec2 q = c0 + ivec2(x, y);
        // w: (q - 1), z: (q.x, q.y - 1), x: (q.x - 1, q.y), y: q
        vec4 e = textureGather(depth, vec2(q) / vec2(ds), 0);
        if (e.w < d) { d = e.w; at = q - 1; }
        if (e.z < d) { d = e.z; at = q - ivec2(0, 1); }
        if (e.x < d) { d = e.x; at = q - ivec2(1, 0); }
        if (e.y < d) { d = e.y; at = q; }
    }
    at = clamp(at, ivec2(0), ds - 1);
    return texel_motion(r == 0 ? uv : (vec2(at) + 0.5) / vec2(ds), d);
}
// The splatted field's motion at uv (framegen_splat.comp): of the nearest surface landing within r texels of uv's (the
// depth dilation, for see-through things that write no depth), from the texel it came from. False where nothing landed
// on uv's own texel.
bool splat_motion(vec2 uv, out vec2 m) {
    ivec2 ds = imageSize(splat_depth), at = clamp(ivec2(uv * vec2(ds)), ivec2(0), ds - 1);
    uint k = imageLoad(splat_depth, at).r;
    m = vec2(0.0);
    if (k == SPLAT_NONE) return false;
    int r = int(p.opt.z) >> 2;
    ivec2 best = at;
    for (int y = -r; y <= r; y++) for (int x = -r; x <= r; x++) {
        ivec2 c = clamp(at + ivec2(x, y), ivec2(0), ds - 1);
        uint e = imageLoad(splat_depth, c).r;
        if (e < k) { k = e; best = c; }
    }
    uint s = imageLoad(splat_src, best).r;
    m = texel_motion((vec2(uvec2(s & 0xffffu, s >> 16)) + 0.5) / vec2(ds), uintBitsToFloat(k));
    return true;
}
// A hole's motion: what shows there at t was hidden in this frame behind something nearer, so it moves with the far side
// of the hole. The first surface landed on along each of 8 directions (1 to 32 texels out); the farthest of them. A hole
// with about the same depth all around is a crack instead (a near surface stretching wider than the splats cover): it
// takes the nearest side's motion and stays an ordinary pixel (crack true). With depth d in [0, 1] (not reversed), 1 - d
// goes as one over the distance, so the two sides' (1 - d) ratio is their distance ratio.
bool hole_motion(vec2 uv, out vec2 m, out bool crack) {
    ivec2 ds = imageSize(splat_depth), at = clamp(ivec2(uv * vec2(ds)), ivec2(0), ds - 1), best = at, nearest = at;
    uint far = 0u, near = SPLAT_NONE; bool found = false;
    m = vec2(0.0); crack = false;
    for (int i = 0; i < 8; i++) {
        ivec2 dir = ivec2(i == 0 || i == 4 || i == 5 ? 1 : i == 1 || i == 6 || i == 7 ? -1 : 0, i == 2 || i == 4 || i == 6 ? 1 : i == 3 || i == 5 || i == 7 ? -1 : 0);
        for (int n = 1; n <= 32; n *= 2) {
            ivec2 c = at + dir * n;
            if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, ds))) break;
            uint e = imageLoad(splat_depth, c).r;
            if (e == SPLAT_NONE) continue;
            if (e >= far) { far = e; best = c; found = true; }
            if (e < near) { near = e; nearest = c; }
            break;
        }
    }
    if (!found) return false;
    float dn = 1.0 - uintBitsToFloat(near), df = 1.0 - uintBitsToFloat(far);
    crack = df > 0.0 && dn < df * 1.15;
    if (crack) { best = nearest; far = near; }
    uint s = imageLoad(splat_src, best).r;
    m = texel_motion((vec2(uvec2(s & 0xffffu, s >> 16)) + 0.5) / vec2(ds), uintBitsToFloat(far));
    return true;
}
vec3 enc(vec3 c) {
    if (p.opt.w == 0.0) return c;
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}
vec3 cur(vec2 uv) { return enc(textureLod(cur_pic, uv * p.scale.xy, 0.0).rgb); }
vec3 prv(vec2 uv) { return enc(textureLod(prev_pic, uv * p.scale.xy, 0.0).rgb); }
// Catmull-Rom (bicubic) sampling for the output's colours: a bilinear sample at a fractional position softens detail, and
// generated pictures one in two softer than the real ones flicker in sharpness (about 5% less edge energy measured with
// bilinear). Five bilinear fetches (the corners of the 4x4 footprint dropped), in the picture's own texels.
vec3 bicubic(sampler2D s, vec2 uv) {
    vec2 ts = vec2(textureSize(s, 0)), pos = uv * p.scale.xy * ts, c = floor(pos - 0.5) + 0.5, f = pos - c;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f)), w1 = 1.0 + f * f * (-2.5 + 1.5 * f), w2 = f * (0.5 + f * (2.0 - 1.5 * f)), w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2, t0 = (c - 1.0) / ts, t3 = (c + 2.0) / ts, t12 = (c + w2 / w12) / ts;
    vec3 r = textureLod(s, vec2(t12.x, t0.y), 0.0).rgb * (w12.x * w0.y) + textureLod(s, vec2(t0.x, t12.y), 0.0).rgb * (w0.x * w12.y)
           + textureLod(s, t12, 0.0).rgb * (w12.x * w12.y) + textureLod(s, vec2(t3.x, t12.y), 0.0).rgb * (w3.x * w12.y)
           + textureLod(s, vec2(t12.x, t3.y), 0.0).rgb * (w12.x * w3.y);
    float n = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return enc(max(r / n, vec3(0.0)));
}
// mean absolute difference of 3x3 patches around uc (current) and up (previous)
float mismatch(vec2 uc, vec2 up) {
    float e = 0.0;
    for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
        vec2 d = vec2(x, y) * (1.0 / p.size.xy);
        vec3 a = cur(uc + d), b = prv(up + d);
        e += abs(a.r - b.r) + abs(a.g - b.g) + abs(a.b - b.b);
    }
    return e / 27.0;
}

void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= int(p.size.x) || o.y >= int(p.size.y)) return;
    vec2 uv = (vec2(o) + 0.5) * (1.0 / p.size.xy);
    float t = p.scale.w;
    // A hole in the splatted field: what shows there at t was hidden in this frame, so the motion candidate takes the
    // previous picture alone along the far side's motion, with a fixed score (size.w, a share of the threshold; the
    // current picture cannot confirm it). The other candidates still compete: where the geometry's motion is wrong (wind
    // in foliage) the holes are not real, and the unmoved picture often matches better.
    vec2 m;
    bool hole = p.size.w != 0.0 && !splat_motion(uv, m);
    bool crack;
    if (hole && !hole_motion(uv, m, crack)) { hole = false; m = motion(uv); }
    else if (hole && crack) hole = false;
    if (p.size.w == 0.0) { m = motion(uv); m = motion(uv - (1.0 - t) * m); }
    vec2 uc = uv - (1.0 - t) * m, up = uv + t * m;
    bool inside = all(greaterThanEqual(up, vec2(0.0))) && all(lessThanEqual(up, vec2(1.0)));
    // The scene motion is geometry (depth and camera, or the object's own), right for nearly everything that does not
    // move on its own; in fine detail (nets, railings, foliage) the patch comparison is noisy, and without a head start
    // the choice flips between candidates pixel by pixel and picture by picture: a shimmer along edges.
    float em_raw = !inside ? 1e9 : hole ? p.size.w * p.opt.y : mismatch(uc, up), em = hole ? em_raw : max(em_raw - p.tune.z * p.opt.y, 0.0);
    // The previous picture blends in only where the scene motion's match is unsure (none below a quarter of the
    // threshold, all of tune.w at it): blended everywhere, generated pictures lost 6-10% of the real frames' detail (a
    // softness flicker at the game's rate); where the match is good, the current picture warped is the sharper answer.
    float wp = clamp(1.0 - t, 0.0, 1.0) * p.tune.w * smoothstep(0.25, 1.0, em_raw / p.opt.y);
    float es = mismatch(uv, uv);
    // Soft choice: each candidate weighted by how well it matches, the current picture by the threshold. A hard pick
    // flips edge pixels (Link against a background that moves with the camera, water) between the three from one
    // generated picture to the next, which shows as a flickering outline; weights fade between them instead.
    // Exponents relative to the best score: with sharp weights the absolute ones underflow, and 0/0 drew black specks.
    float k = 1.0 / (p.tune.x * p.opt.y), best = min(min(em, es), p.opt.y);
    float wm = inside ? exp(-(em - best) * k) : 0.0, ws = exp(-(es - best) * k), wc = exp(-(p.opt.y - best) * k) * p.tune.y;
    float wsum = wm + ws + wc;
    vec3 mc = hole && t < 1.0 ? bicubic(prev_pic, up) : mix(bicubic(cur_pic, uc), bicubic(prev_pic, up), wp);
    vec3 col = wsum > 1e-6 ? (wm * mc + ws * mix(bicubic(cur_pic, uv), bicubic(prev_pic, uv), wp) + wc * bicubic(cur_pic, uv)) / wsum : bicubic(cur_pic, uv);
    // <files>/fgdebug: red current picture, green scene motion, blue no motion
    if ((int(p.opt.z) & 1) != 0) col = mix(col, hole ? vec3(1.0, 0.0, 1.0) * wm / max(wsum, 1e-6) : vec3(wc, wm, ws) / max(wsum, 1e-6), 0.35);
    // For the quality test (opt.z bit 2): how the scene's motion fared here, in alpha: 1 matched (under a quarter of the
    // threshold), 0.75 unsure, 0.5 rejected (at or over the threshold: things moving in their shaders, wind, water), 0.25
    // a hole, 0 its source off the previous picture's edge.
    float cls = 1.0;
    if ((int(p.opt.z) & 2) != 0) cls = !inside ? 0.0 : hole ? 0.25 : em_raw >= p.opt.y ? 0.5 : em_raw > 0.25 * p.opt.y ? 0.75 : 1.0;
    imageStore(dst, o, vec4(col, cls));
}
