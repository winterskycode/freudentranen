// Frame generation: the picture halfway between the previous and this game frame (nvn_vulkan_framegen.inc), from the
// two scenes (no UI; the HUD goes on top afterwards, framegen_hud.comp) or the two finished pictures.
// Two motion candidates per pixel:
//  - the camera's: this frame's G-buffer depth reprojected with the previous frame's view-projection
//    (reproj = VP_prev * inverse(VP_cur), the Mac port's convention: GL clip space, depth not reversed);
//  - none: the HUD, and whatever moves with the camera (Link while it orbits him), stay where they are.
// A point at uv now was at uv + m in the previous frame; halfway it is at uv + m/2, so the output takes the current
// picture at o - m/2 and the previous one at o + m/2. Each candidate is scored by how well a 3x3 patch of the current
// picture matches the previous one along it; the candidates and the current picture alone (for disocclusion and things
// moving on their own) are blended by those scores.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform P {
    mat4 reproj;   // previous view-projection * inverse(current view-projection)
    vec4 size;     // output w, h, 1/w, 1/h
    vec4 opt;      // x: clip-space y direction (+1), y: match threshold (mean abs difference per channel), z: debug tint,
                   // w: 1 when the pictures are scenes (linear canvas values, sRGB-encoded here)
    vec4 scale;    // xy: the picture's share of the picture textures (picture size / texture size)
} p;
layout(set = 0, binding = 0) uniform sampler2D prev_pic;
layout(set = 0, binding = 1) uniform sampler2D cur_pic;
layout(set = 0, binding = 2) uniform sampler2D unused_;
layout(set = 0, binding = 3) uniform sampler2D depth;
layout(set = 0, binding = 4, rgba8) uniform writeonly image2D dst;

vec2 motion(vec2 uv) {   // where uv was in the previous frame, minus uv (normalized picture units)
    ivec2 ds = textureSize(depth, 0);
    float d = texelFetch(depth, clamp(ivec2(uv * vec2(ds)), ivec2(0), ds - 1), 0).r;
    if (d >= 1.0) return vec2(0.0);   // sky / cleared depth: no camera reprojection
    vec4 c = p.reproj * vec4(uv.x * 2.0 - 1.0, p.opt.x * (1.0 - uv.y * 2.0), d * 2.0 - 1.0, 1.0);
    if (c.w <= 1e-7) return vec2(0.0);
    vec2 n = c.xy / c.w;
    return vec2(n.x * 0.5 + 0.5, 0.5 - 0.5 * p.opt.x * n.y) - uv;
}
vec3 enc(vec3 c) {
    if (p.opt.w == 0.0) return c;
    c = clamp(c, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}
vec3 cur(vec2 uv) { return enc(textureLod(cur_pic, uv * p.scale.xy, 0.0).rgb); }
vec3 prv(vec2 uv) { return enc(textureLod(prev_pic, uv * p.scale.xy, 0.0).rgb); }
float mismatch(vec2 uc, vec2 up) {   // mean absolute difference of 3x3 patches around uc (current) and up (previous)
    float e = 0.0;
    for (int y = -1; y <= 1; y++) for (int x = -1; x <= 1; x++) {
        vec2 d = vec2(x, y) * p.size.zw;
        vec3 a = cur(uc + d), b = prv(up + d);
        e += abs(a.r - b.r) + abs(a.g - b.g) + abs(a.b - b.b);
    }
    return e / 27.0;
}

void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= int(p.size.x) || o.y >= int(p.size.y)) return;
    vec2 uv = (vec2(o) + 0.5) * p.size.zw;
    vec2 m = motion(uv);
    m = motion(uv - 0.5 * m);
    vec2 uc = uv - 0.5 * m, up = uv + 0.5 * m;
    bool inside = all(greaterThanEqual(up, vec2(0.0))) && all(lessThanEqual(up, vec2(1.0)));
    float em = inside ? mismatch(uc, up) : 1e9;
    float es = mismatch(uv, uv);
    // Soft choice: each candidate weighted by how well it matches, the current picture by the threshold. A hard pick
    // flips edge pixels (Link against a background that moves with the camera, water) between the three from one
    // generated picture to the next, which shows as a flickering outline; weights fade between them instead.
    float k = 1.0 / (0.35 * p.opt.y);
    float wm = inside ? exp(-em * k) : 0.0, ws = exp(-es * k), wc = exp(-p.opt.y * k);
    vec3 col = (wm * 0.5 * (cur(uc) + prv(up)) + ws * 0.5 * (cur(uv) + prv(uv)) + wc * cur(uv)) / (wm + ws + wc);
    if (p.opt.z != 0.0) col = mix(col, vec3(wc, wm, ws) / (wm + ws + wc), 0.35);   // <files>/fgdebug: red current picture, green camera motion, blue no motion
    imageStore(dst, o, vec4(col, 1.0));
}
